{
  "name": "pxpipe-fork",
  "version": "0.17.0-fork.1",
  "description": "Fork of teamchong/pxpipe (Steven) plus @sriinnu/pakt. Lossless PAKT for structured text, pxpipe images only for readers that can see them. Not an official teamchong release.",
  "type": "module",
  "bin": {
    "pxpipe": "bin/cli.js",
    "pxpipe-fork": "bin/cli.js",
    "pxpipe-mcp": "bin/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./transform": {
      "types": "./dist/core/library.d.ts",
      "import": "./dist/core/library.js"
    },
    "./measurement": {
      "types": "./dist/core/measurement.d.ts",
      "import": "./dist/core/measurement.js"
    },
    "./applicability": {
      "types": "./dist/core/applicability.d.ts",
      "import": "./dist/core/applicability.js"
    },
    "./proxy": {
      "types": "./dist/core/proxy.d.ts",
      "import": "./dist/core/proxy.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/*.map",
    "assets/*LICENSE.txt",
    "README.md",
    "SECURITY.md",
    "NOTICE",
    "docs/SECURITY_MODEL.md",
    "LICENSE"
  ],
  "scripts": {
    "audit": "pnpm audit --prod --audit-level high",
    "build": "node scripts/build.mjs",
    "build:atlas": "tsx scripts/gen-atlas.ts",
    "dev:node": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "restart": "node scripts/restart.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "vendor:ui": "node scripts/vendor-ui.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "fable-5",
    "proxy",
    "token-optimization",
    "prompt-cache",
    "vision-tokens",
    "cloudflare-workers",
    "pakt",
    "mcp"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.21.0",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@sriinnu/pakt": "0.10.0",
    "gpt-tokenizer": "^4.1.1"
  },
  "author": "Srinivas Pendela (https://github.com/sriinnu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriinnu/inkling.git"
  },
  "homepage": "https://github.com/sriinnu/inkling#readme",
  "bugs": {
    "url": "https://github.com/sriinnu/inkling/issues"
  },
  "pxpipeUpstream": {
    "repo": "https://github.com/teamchong/pxpipe",
    "author": "Steven (https://github.com/teamchong)",
    "version": "0.16.0",
    "commit": "9e0e0e99b4483f40e8a58036bb1f6a1a81c331e3",
    "license": "MIT"
  },
  "pakt": {
    "package": "@sriinnu/pakt",
    "version": "0.10.0",
    "repo": "https://github.com/sriinnu/clipforge-PAKT",
    "author": "Srinivas Pendela (https://github.com/sriinnu)",
    "license": "MIT"
  }
}
