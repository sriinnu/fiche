{
  "name": "@sriinnu/fiche",
  "version": "0.18.0",
  "description": "Microfiche for coding agents — cache-safe hybrid optical + deterministic text context compiler & <5 ms local proxy.",
  "type": "module",
  "bin": {
    "fiche": "bin/cli.js",
    "fiche-mcp": "bin/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./transform": {
      "types": "./dist/core/library.d.ts",
      "import": "./dist/core/library.js"
    },
    "./measurement": {
      "types": "./dist/core/measurement.d.ts",
      "import": "./dist/core/measurement.js"
    },
    "./applicability": {
      "types": "./dist/core/applicability.d.ts",
      "import": "./dist/core/applicability.js"
    },
    "./proxy": {
      "types": "./dist/core/proxy.d.ts",
      "import": "./dist/core/proxy.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/*.map",
    "plugins/",
    "assets/*LICENSE.txt",
    "assets/fiche-*.svg",
    "README.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md",
    "NOTICE",
    "docs/SECURITY_MODEL.md",
    "LICENSE"
  ],
  "scripts": {
    "audit": "pnpm audit --prod --audit-level high",
    "build": "node scripts/build.mjs",
    "charts:gen": "tsx scripts/gen-fiche-charts.ts && tsx scripts/gen-context-chart.ts",
    "build:atlas": "tsx scripts/gen-atlas.ts",
    "dev:node": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "restart": "node scripts/restart.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm test",
    "vendor:ui": "node scripts/vendor-ui.mjs",
    "prices:gen": "tsx scripts/gen-prices.ts",
    "prices:check": "tsx scripts/gen-prices.ts --check"
  },
  "keywords": [
    "fiche",
    "microfiche",
    "context-compiler",
    "coding-agents",
    "toon",
    "prompt-cache",
    "vision-tokens",
    "mcp",
    "claude-code",
    "codex",
    "antigravity"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.21.0",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.1.1"
  },
  "author": "Srinivas Pendela (https://github.com/sriinnu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriinnu/fiche.git"
  },
  "homepage": "https://fiche.srinivas.dev",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sriinnu"
  },
  "bugs": {
    "url": "https://github.com/sriinnu/fiche/issues"
  }
}
